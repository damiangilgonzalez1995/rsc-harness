---
config:
  look: handDrawn
  handDrawnSeed: 7
  theme: base
  themeVariables:
    fontFamily: "Segoe UI, sans-serif"
    fontSize: "15px"
    primaryColor: "#FDF6E3"
    primaryTextColor: "#1b1b1f"
    primaryBorderColor: "#1b1b1f"
    lineColor: "#3d3d42"
  flowchart:
    curve: basis
    nodeSpacing: 45
    rankSpacing: 60
---

flowchart TD
    START(["Quiero construir,<br/>añadir o cambiar algo"]) --> T{"¿Qué tamaño<br/>tiene?"}

    T -->|"una línea:<br/>errata, config"| ONE["Hazlo sin más<br/>y di que te saltas la cadena"]

    T -->|"pequeño:<br/>una sesión, un ticket"| QV{"¿La idea<br/>está clara?"}
    QV -->|"aún verde"| BS["<b>superpowers:brainstorming</b><br/>descubre qué quieres"]
    QV -->|"hay un plan"| GS["<b>grill-with-docs</b><br/>endurece el plan"]
    BS --> IM["<b>implement</b><br/>con TDD"]
    GS --> IM

    T -->|"grande:<br/>varias sesiones, muchas piezas"| QB{"¿Se ve<br/>el camino?"}
    QB -->|sí| GB["<b>grill-with-docs</b><br/>baja la idea a tierra"]
    QB -->|no| WF["<b>wayfinder</b><br/>mapa de decisiones"]
    GB --> SP["<b>to-spec</b><br/>escribe la spec"]
    WF --> SP
    SP --> TK["<b>to-tickets</b><br/>grafo de tickets con bloqueos"]
    TK --> IS["<b>implement-spec</b><br/>subagentes en paralelo"]

    SP -.- ADR{{"<b>write-adr</b><br/>decisiones difíciles<br/>de revertir"}}
    IM -.- UI{{"<b>flujo-interfaz</b><br/>si toca pantalla"}}
    IS -.- UI

    IM --> CR["<b>code-review</b><br/>estándares + spec"]
    IS --> CR
    CR --> PRN["<b>pr</b><br/>resumen, evidencia,<br/>peligro de fusión"]
    PRN --> END(["Fusionar"])
